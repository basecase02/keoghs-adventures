# Copy to .env.local and fill in. Never commit real values.
# Real secrets live in AWS Secrets Manager / Amplify environment settings, not in this file.

# Public (safe in the browser)
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Server only (never prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
DATABASE_URL=postgres://user:pass@host:5432/keoghs
SES_FROM_EMAIL=bookings@keoghsadventures.com
